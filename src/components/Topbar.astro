---
const { user } = Astro.locals;
---

<div
  class="border-border bg-card text-foreground/80 mb-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 rounded-xl border px-4 py-2 text-sm"
>
  {
    user ? (
      <>
        <span class="text-muted-foreground min-w-0 truncate">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-primary hover:text-primary/70 transition-colors hover:underline">
            Planning dashboard
          </a>
          <a href="/settings" class="text-primary hover:text-primary/70 transition-colors hover:underline">
            Settings
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-primary hover:text-primary/70 transition-colors hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground min-w-0 truncate">PrepToClimb account access</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-primary hover:text-primary/70 transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-primary hover:text-primary/70 transition-colors hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
