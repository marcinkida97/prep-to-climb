---
import { Anchor, Route, ShieldCheck } from "lucide-react";
import Topbar from "@/components/Topbar.astro";
---

<div class="bg-background relative min-h-screen w-full overflow-hidden">
  <!-- Mountain-range backdrop (original illustration, drawn with theme tokens) -->
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[45vh] w-full min-w-[900px]"
    viewBox="0 0 1200 400"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
  >
    <path
      d="M0 400 L150 220 L280 320 L420 140 L560 300 L700 180 L860 340 L1000 200 L1200 400 Z"
      class="fill-secondary/15"></path>
    <path
      d="M0 400 L220 260 L360 360 L520 200 L680 340 L840 240 L1000 380 L1200 260 L1200 400 Z"
      class="fill-primary/15"></path>
    <path d="M0 400 L180 340 L340 380 L500 300 L660 390 L820 320 L980 400 L1200 340 L1200 400 Z" class="fill-muted"
    ></path>
  </svg>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div
      class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 md:py-36 lg:py-40"
    >
      <h1
        class="from-primary to-secondary mb-6 bg-gradient-to-r bg-clip-text font-[family-name:var(--font-display)] text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
      >
        PrepToClimb
      </h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        Turn a short climbing check-in into a focused weekly training plan built around your current grade and limits.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
        >
          Sign in to continue
        </a>
        <a
          href="/auth/signup"
          class="border-border text-foreground hover:bg-muted inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium transition-colors"
        >
          Create an account
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="border-border bg-card rounded-xl border p-6">
        <Anchor className="text-secondary mb-4 size-6" />
        <h3 class="text-foreground mb-2 text-lg font-semibold">Protected planning space</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Save your account, sign in securely, and keep the planning flow behind authenticated access.
        </p>
      </div>

      <div class="border-border bg-card rounded-xl border p-6">
        <Route className="text-secondary mb-4 size-6" />
        <h3 class="text-foreground mb-2 text-lg font-semibold">Fast weekly plan setup</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          The MVP is built to get you from account access to a usable weekly climbing plan without unnecessary steps.
        </p>
      </div>

      <div class="border-border bg-card rounded-xl border p-6">
        <ShieldCheck className="text-secondary mb-4 size-6" />
        <h3 class="text-foreground mb-2 text-lg font-semibold">Safer recommendations</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          PrepToClimb is being shaped to steer training around your declared limitations while keeping your week
          actionable.
        </p>
      </div>
    </div>
  </div>
</div>
