---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: color-mix(in oklch, var(--secondary) 18%, var(--background));
    color: var(--secondary);
    border-color: var(--secondary);
  }
  .banner--warning {
    background: color-mix(in oklch, var(--chart-3) 22%, var(--background));
    color: var(--chart-3);
    border-color: var(--chart-3);
  }
  .banner--error {
    background: color-mix(in oklch, var(--destructive) 18%, var(--background));
    color: var(--destructive);
    border-color: var(--destructive);
  }
</style>
