---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/PageShell.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Account ready",
      description: "Your PrepToClimb account is ready. Sign in to enter the protected planning area and continue.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Confirm your email to unlock planning",
      description:
        "We've sent a confirmation link to your email address. Open it to confirm your account and continue straight into your protected planning area.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <PageShell variant="centered">
    <div class="border-border bg-card text-foreground w-full max-w-sm rounded-2xl border p-8 text-center">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1
        class="from-primary to-secondary mb-3 bg-gradient-to-r bg-clip-text font-[family-name:var(--font-display)] text-2xl font-bold text-transparent"
      >
        {content.heading}
      </h1>
      <p class="text-muted-foreground mb-6">{content.description}</p>
      <a href="/auth/signin" class="text-primary text-sm hover:underline">
        {content.linkText}
      </a>
    </div>
  </PageShell>
</Layout>
