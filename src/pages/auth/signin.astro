---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/PageShell.astro";
import SignInForm from "@/components/auth/SignInForm";
import { SuccessMessage } from "@/components/auth/SuccessMessage";

const error = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
---

<Layout title="Sign in | PrepToClimb">
  <PageShell variant="centered">
    <div class="border-border bg-card text-foreground w-full max-w-sm rounded-2xl border p-8">
      <h1
        class="from-primary to-secondary mb-6 bg-gradient-to-r bg-clip-text text-center font-[family-name:var(--font-display)] text-2xl font-bold text-transparent"
      >
        Sign in to PrepToClimb
      </h1>
      <p class="text-muted-foreground mb-6 text-center text-sm leading-6">
        Return to your protected planning space and pick up where your training flow left off.
      </p>
      {
        message ? (
          <div class="mb-4">
            <SuccessMessage message={message} />
          </div>
        ) : null
      }
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Need an account first? <a href="/auth/signup" class="text-primary hover:underline">Create one here</a>
      </p>
    </div>
  </PageShell>
</Layout>
