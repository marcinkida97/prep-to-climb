---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/PageShell.astro";
import SignInForm from "@/components/auth/SignInForm";
import { SuccessMessage } from "@/components/auth/SuccessMessage";

const error = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
---

<Layout title="Sign in | PrepToClimb">
  <PageShell variant="centered">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in to PrepToClimb
      </h1>
      <p class="mb-6 text-center text-sm leading-6 text-blue-100/70">
        Return to your protected planning space and pick up where your training flow left off.
      </p>
      {
        message ? (
          <div class="mb-4">
            <SuccessMessage message={message} />
          </div>
        ) : null
      }
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Need an account first? <a href="/auth/signup" class="text-purple-300 hover:underline">Create one here</a>
      </p>
    </div>
  </PageShell>
</Layout>
