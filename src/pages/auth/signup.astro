---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/PageShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up | PrepToClimb">
  <PageShell variant="centered">
    <div class="border-border bg-card text-foreground w-full max-w-sm rounded-2xl border p-8">
      <h1
        class="from-primary to-secondary mb-6 bg-gradient-to-r bg-clip-text text-center font-[family-name:var(--font-display)] text-2xl font-bold text-transparent"
      >
        Create your PrepToClimb account
      </h1>
      <p class="text-muted-foreground mb-6 text-center text-sm leading-6">
        Set up access now so you can move into the protected weekly-planning flow as soon as your account is ready.
      </p>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Already registered? <a href="/auth/signin" class="text-primary hover:underline">Sign in instead</a>
      </p>
    </div>
  </PageShell>
</Layout>
