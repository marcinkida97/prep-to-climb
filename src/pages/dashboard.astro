---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import DashboardPlanShell from "@/components/plans/DashboardPlanShell";
import { createPlanPersistence } from "@/lib/plan-persistence";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const persistence = supabase ? createPlanPersistence(supabase) : null;
const initialPlan = user && persistence ? await persistence.getCurrentPlan(user.id) : null;
---

<Layout title="Planning dashboard | PrepToClimb">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="relative z-10 mx-auto max-w-5xl">
      <Topbar />
    </div>
    <div class="mx-auto max-w-5xl py-6">
      <div class="mb-6 max-w-3xl text-white">
        <p class="text-sm font-medium tracking-[0.28em] text-cyan-200/75 uppercase">Weekly planning dashboard</p>
        <p class="mt-3 text-base leading-7 text-blue-100/78">
          This protected page is the real planning surface now: answer the questionnaire, review the saved seven-day
          week, and regenerate the plan from the same place when your training context changes.
        </p>
      </div>
      <DashboardPlanShell client:load initialPlan={initialPlan} userEmail={user?.email ?? null} />
    </div>
  </div>
</Layout>
