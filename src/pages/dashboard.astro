---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-3xl font-bold text-transparent"
      >
        Dashboard
      </h1>
      <p class="text-center text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-center text-sm text-blue-100/50">This page is only for authenticated users.</p>

      <div class="mt-8 rounded-xl border border-white/10 bg-slate-950/20 p-5">
        <h2 class="text-lg font-semibold text-white">Persistence smoke test</h2>
        <p class="mt-2 text-sm leading-6 text-blue-100/75">
          This button calls the temporary authenticated smoke route for `F-01`. It writes a sample questionnaire and
          weekly plan for your current user, then returns the saved payload as JSON.
        </p>
        <form method="POST" action="/api/plans/smoke" class="mt-4">
          <button
            type="submit"
            class="rounded-lg border border-emerald-300/30 bg-emerald-400/15 px-4 py-2 text-sm font-medium text-emerald-100 transition-colors hover:bg-emerald-400/25"
          >
            Run persistence smoke test
          </button>
        </form>
      </div>

      <form method="POST" action="/api/auth/signout" class="mt-6 text-center">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
