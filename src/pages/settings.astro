---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/PageShell.astro";
import ChangePasswordForm from "@/components/auth/ChangePasswordForm";
import { ServerError } from "@/components/auth/ServerError";

const { user } = Astro.locals;
const pwError = Astro.url.searchParams.get("pwError");
const pwSuccess = Astro.url.searchParams.get("pwSuccess");
const delError = Astro.url.searchParams.get("delError");
---

<Layout title="Account settings | PrepToClimb">
  <PageShell maxWidth="3xl">
    <div class="text-foreground mb-6 max-w-2xl">
      <p class="text-secondary text-sm font-medium tracking-[0.28em] uppercase">Account settings</p>
      <p class="text-muted-foreground mt-3 text-base leading-7">
        Managing account: <span class="text-foreground font-medium">{user?.email ?? "your account"}</span>
      </p>
    </div>

    <div class="border-border bg-card text-foreground space-y-8 rounded-[2rem] border p-6 shadow-2xl sm:p-8">
      <section>
        <h2 class="text-foreground mb-4 text-xl font-semibold">Change password</h2>
        <ChangePasswordForm serverError={pwError} successMessage={pwSuccess} client:load />
      </section>

      <section class="border-border border-t pt-8">
        <h2 class="text-foreground mb-2 text-xl font-semibold">Delete account</h2>
        <p class="text-muted-foreground mb-4 text-sm leading-6">
          Permanently delete your account and all saved data. This cannot be undone.
        </p>
        <ServerError message={delError} />
        <form
          method="POST"
          action="/api/account/delete-account"
          onsubmit="return confirm('Delete your account? This cannot be undone.')"
          class="mt-4"
        >
          <button
            type="submit"
            class="border-destructive/40 bg-destructive/10 text-destructive hover:bg-destructive/20 rounded-lg border px-4 py-2 font-medium transition-colors"
          >
            Delete account
          </button>
        </form>
      </section>
    </div>
  </PageShell>
</Layout>
